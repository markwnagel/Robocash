<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alpaca-desk.daily</string>
	<!-- The command lives in launchd/teamrobo-desk so macOS lists this job by that name under Login Items &
	     Extensions > Allow in the Background. Inline /bin/sh -c showed as "sh" and was switched off there. -->
	<key>ProgramArguments</key>
	<array>
		<string>__PROJECT_DIR__/launchd/teamrobo-desk</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/state/launchd.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/state/launchd.log</string>
	<!-- launchd uses the Mac's LOCAL time (Pacific): 13:45 here is 16:45 ET, 45 minutes after the close.
	     It must run before the 14:00 monitor + report job, and the pmset wake at 13:40 covers it.
	     16:45 here (as set 2026-09-17 to 09-24) meant 19:45 ET, after the email. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>2</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>3</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>4</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>5</integer>
		</dict>
	</array>
	<!-- Names the job for the run's telemetry. launchd's own XPC_SERVICE_NAME reaches only the program launchd
	     starts; Python, two processes down, recorded every scheduled run on 2026-09-30 as manual (monitor F-17). -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>TEAMROBO_JOB</key>
		<string>com.alpaca-desk.daily</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>
</dict>
</plist>
