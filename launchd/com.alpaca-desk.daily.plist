<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alpaca-desk.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/usr/bin/caffeinate -i __PROJECT_DIR__/.venv/bin/python __PROJECT_DIR__/run_daily.py; exec /usr/bin/caffeinate -i -t 1200</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/state/launchd.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/state/launchd.log</string>
	<!-- launchd uses the Mac's LOCAL time (Pacific): 13:45 here is 16:45 ET, 45 minutes after the close.
	     It must run before the 14:00 monitor + report job, and the pmset wake at 13:40 covers it.
	     16:45 here (as set 2026-09-17 to 09-24) meant 19:45 ET, after the email. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>2</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>3</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>4</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>5</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>
</dict>
</plist>
