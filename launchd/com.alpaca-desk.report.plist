<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.alpaca-desk.report</string>
  <!-- Monitor, then the email: see launchd/teamrobo-email. A named script so macOS lists this job as
       "teamrobo-email" under Login Items & Extensions > Allow in the Background, not "sh". -->
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/launchd/teamrobo-email</string>
  </array>
  <!-- Names the job for the run's telemetry. launchd's own XPC_SERVICE_NAME reaches only the program launchd
       starts; Python, two processes down, recorded every scheduled run on 2026-09-30 as manual (monitor F-17). -->
  <key>EnvironmentVariables</key>
  <dict><key>TEAMROBO_JOB</key><string>com.alpaca-desk.report</string></dict>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <!-- 14:00 local, weekdays. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__PROJECT_DIR__/state/launchd-report.log</string>
  <key>StandardErrorPath</key><string>__PROJECT_DIR__/state/launchd-report.log</string>
</dict>
</plist>
