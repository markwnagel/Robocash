.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.claude/settings.local.json

# Runtime state - account data, trades, briefs, emails, caches, telemetry, monitor state. Never committed.
state/*
# ...except the frozen backtest inputs, so a fresh clone reproduces the published backtest numbers.
# (The frozen price panel under state/history/prices is 45MB and is re-downloaded instead.)
!state/history/
state/history/*
!state/history/universe_bt*.json
!state/history/earnings.csv
!state/history/trials.jsonl
!state/history/live_reference.json
# The point-in-time universe definition (robustness.py); its download caches and ~300MB panel are rebuilt.
!state/history/pit/
state/history/pit/*
!state/history/pit/members.csv
!state/history/pit/build.json
