# Alpaca paper-trading keys: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Anthropic key for the analyst (or run `ant auth login` and leave blank)
ANTHROPIC_API_KEY=

# SEC EDGAR requires a contact User-Agent ("Name email"). Filings/insider data are skipped without it.
SEC_USER_AGENT=

# Finnhub free tier (finnhub.io) for the earnings calendar. Without it every candidate is blocked (no new entries).
FINNHUB_API_KEY=

# Optional: Slack/Discord-style incoming webhook for the daily brief
DESK_WEBHOOK_URL=

# Daily report email (report_daily.py, and the monitor's SEV1 alerts). Gmail: use an app password
# (myaccount.google.com/apppasswords), never the account password. Or set RESEND_API_KEY instead of SMTP_*.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM=
REPORT_TO=
RESEND_API_KEY=
